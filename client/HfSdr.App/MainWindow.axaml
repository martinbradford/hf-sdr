<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:HfSdr.App"
        x:Class="HfSdr.App.MainWindow"
        Width="920" Height="620"
        Title="HF SDR — Client (architecture proof)">
  <DockPanel Margin="10">

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Host:" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="HostBox" Width="160" Text="localhost"/>
        <CheckBox x:Name="SupervisorBox" Content="Start via supervisor" VerticalAlignment="Center"
                  ToolTip.Tip="Ask the supervisor service on the host to launch the server (twin-PC). Off = attach to a server already running."/>
        <CheckBox x:Name="ReleaseBox" Content="Release receiver on close" VerticalAlignment="Center"
                  ToolTip.Tip="Stop the remote server when this window closes (supervisor mode only)."/>
        <Button x:Name="StopRxBtn" Content="Stop receiver" IsEnabled="False" Click="OnStopReceiver"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnect"/>
        <TextBlock Text="Freq (MHz):" VerticalAlignment="Center"/>
        <TextBox x:Name="FreqBox" Width="110" Text="7.150"/>
        <Button x:Name="TuneBtn" Content="Tune" Click="OnTune"/>
        <ComboBox x:Name="ModeBox" Width="90" SelectedIndex="0" SelectionChanged="OnModeChanged">
          <ComboBoxItem>lsb</ComboBoxItem>
          <ComboBoxItem>usb</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="BW:" VerticalAlignment="Center"/>
        <ComboBox x:Name="BwBox" Width="110" SelectedIndex="4" SelectionChanged="OnBandwidthChanged"
                  ToolTip.Tip="Audio passband width (low edge fixed at 200 Hz). Applied in place, with no gap, on a running receiver.">
          <ComboBoxItem Tag="500">0.5 kHz</ComboBoxItem>
          <ComboBoxItem Tag="1000">1.0 kHz</ComboBoxItem>
          <ComboBoxItem Tag="1800">1.8 kHz</ComboBoxItem>
          <ComboBoxItem Tag="2400">2.4 kHz</ComboBoxItem>
          <ComboBoxItem Tag="2800">2.8 kHz</ComboBoxItem>
          <ComboBoxItem Tag="3200">3.2 kHz</ComboBoxItem>
          <ComboBoxItem Tag="4000">4.0 kHz</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Audio out:" VerticalAlignment="Center"/>
        <ComboBox x:Name="AudioDeviceBox" Width="200"
                  SelectionChanged="OnAudioDeviceChanged"/>
        <TextBlock Text="← click the waterfall to tune" VerticalAlignment="Center" Opacity="0.7"/>
      </StackPanel>

      <StackPanel x:Name="ConfigBar" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center" IsEnabled="False">
        <TextBlock Text="Tuner:" VerticalAlignment="Center" FontWeight="Bold"/>
        <RadioButton x:Name="SingleRadio" GroupName="tuner" Content="Single" IsChecked="True"
                     VerticalAlignment="Center" IsCheckedChanged="OnTunerModeChanged"/>
        <RadioButton x:Name="DiversityRadio" GroupName="tuner" Content="Diversity"
                     VerticalAlignment="Center" IsCheckedChanged="OnTunerModeChanged"/>
        <Border Width="1" Background="#444" Margin="4,2"/>
        <TextBlock Text="Gain:" VerticalAlignment="Center" FontWeight="Bold"/>
        <CheckBox x:Name="AgcBox" Content="AGC" IsChecked="True"
                  VerticalAlignment="Center" IsCheckedChanged="OnAgcChanged"/>
        <TextBlock Text="RF gr" VerticalAlignment="Center"/>
        <Slider x:Name="RfSlider" Width="150" Minimum="0" Maximum="61"
                VerticalAlignment="Center" ValueChanged="OnRfGainChanged"/>
        <TextBlock x:Name="RfLabel" Width="120" VerticalAlignment="Center" Text="0 dB"/>
        <TextBlock Text="IF gr" VerticalAlignment="Center"/>
        <Slider x:Name="IfSlider" Width="150" Minimum="20" Maximum="59"
                VerticalAlignment="Center" ValueChanged="OnIfGainChanged"/>
        <TextBlock x:Name="IfLabel" Width="60" VerticalAlignment="Center" Text="40 dB"/>
        <Border Width="1" Background="#444" Margin="4,2"/>
        <Border x:Name="PeakBox" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                Background="Transparent">
          <TextBlock x:Name="PeakLabel" VerticalAlignment="Center" MinWidth="130"
                     Text="peak —" FontFamily="Consolas,monospace"/>
        </Border>
        <TextBlock x:Name="AudioStatsLabel" VerticalAlignment="Center" Margin="8,0,0,0"
                   Text="audio —" Opacity="0.85" FontFamily="Consolas,monospace"/>
      </StackPanel>

      <StackPanel x:Name="NullBar" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center" IsEnabled="False">
        <TextBlock Text="Null:" VerticalAlignment="Center" FontWeight="Bold"/>
        <Border x:Name="NullBox" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                Background="Transparent">
          <TextBlock x:Name="NullStatusLabel" VerticalAlignment="Center" MinWidth="230"
                     Text="off — right-click a signal to null it"
                     FontFamily="Consolas,monospace"/>
        </Border>
        <CheckBox x:Name="NullTrackBox" Content="Track" IsChecked="True" IsEnabled="False"
                  VerticalAlignment="Center" IsCheckedChanged="OnNullTrackChanged"/>
        <ComboBox x:Name="NullSpeedBox" Width="80" SelectedIndex="1" IsEnabled="False"
                  VerticalAlignment="Center" SelectionChanged="OnNullSpeedChanged">
          <ComboBoxItem>Fast</ComboBoxItem>
          <ComboBoxItem>Med</ComboBoxItem>
          <ComboBoxItem>Slow</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="amp" VerticalAlignment="Center"/>
        <Slider x:Name="NullAmpSlider" Width="110" Minimum="0" Maximum="4" IsEnabled="False"
                VerticalAlignment="Center" ValueChanged="OnNullTrimChanged"/>
        <TextBlock Text="phase" VerticalAlignment="Center"/>
        <Slider x:Name="NullPhaseSlider" Width="110" Minimum="-180" Maximum="180" IsEnabled="False"
                VerticalAlignment="Center" ValueChanged="OnNullTrimChanged"/>
        <Button x:Name="NullClearBtn" Content="Clear null" IsEnabled="False" Click="OnClearNull"/>
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
               Text="Disconnected — start the server, then Connect." Opacity="0.8"/>

    <Border BorderBrush="#333" BorderThickness="1">
      <DockPanel>
        <app:FrequencyScale x:Name="FreqScale" DockPanel.Dock="Top" Height="26"/>
        <Grid>
          <Image x:Name="Waterfall" Stretch="Fill"
                 PointerPressed="OnWaterfallClick" PointerWheelChanged="OnWaterfallWheel">
            <Image.ContextMenu>
              <ContextMenu Placement="Pointer">
                <MenuItem Header="Null this source" Click="OnNullThis"/>
                <MenuItem Header="Clear null" Click="OnClearNull"/>
              </ContextMenu>
            </Image.ContextMenu>
          </Image>
          <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Rectangle x:Name="NullMarker" Fill="#55F44336" IsVisible="False"/>
            <Rectangle x:Name="Marker" Width="2" Fill="#FFEB3B" IsVisible="False"/>
          </Canvas>
        </Grid>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
