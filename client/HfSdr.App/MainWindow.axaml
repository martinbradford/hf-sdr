<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HfSdr.App.MainWindow"
        Width="920" Height="620"
        Title="HF SDR — Client (architecture proof)">
  <DockPanel Margin="10">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnect"/>
      <TextBlock Text="Freq (MHz):" VerticalAlignment="Center"/>
      <TextBox x:Name="FreqBox" Width="110" Text="7.150"/>
      <Button x:Name="TuneBtn" Content="Tune" Click="OnTune"/>
      <ComboBox x:Name="ModeBox" Width="90" SelectedIndex="0">
        <ComboBoxItem>lsb</ComboBoxItem>
        <ComboBoxItem>usb</ComboBoxItem>
      </ComboBox>
      <TextBlock Text="← click the waterfall to tune" VerticalAlignment="Center" Opacity="0.7"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
               Text="Disconnected — start the server, then Connect." Opacity="0.8"/>

    <Border BorderBrush="#333" BorderThickness="1">
      <Grid>
        <Image x:Name="Waterfall" Stretch="Fill" PointerPressed="OnWaterfallClick"/>
        <Canvas x:Name="Overlay" IsHitTestVisible="False">
          <Rectangle x:Name="Marker" Width="2" Fill="#FFEB3B" IsVisible="False"/>
        </Canvas>
      </Grid>
    </Border>
  </DockPanel>
</Window>
