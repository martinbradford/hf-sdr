<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HfSdr.Supervisor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="NetMQ" Version="4.0.4.2" />
    <!-- Override NetMQ's vulnerable transitive System.Security.Cryptography.Xml 10.0.6 (same as the client) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="supervisor.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
